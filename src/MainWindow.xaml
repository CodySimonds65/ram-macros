<Window x:Class="RamMacros.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RAM Macros" Height="720" Width="1100" Background="#090B10" Foreground="#F5F7FA" WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#11141B" BorderBrush="#272D3A" BorderThickness="1" CornerRadius="14" Padding="14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Button Content="＋  New macro" Click="NewMacro_Click" Background="#7C5CFC" Foreground="White" Padding="12,8"/><Button Content="Import bundle" Click="Import_Click" Margin="0,8,0,0" Background="#1D2230" Foreground="#F5F7FA" Padding="12,8"/><Button Content="Save bundle" Click="Export_Click" Margin="0,8,0,0" Background="#1D2230" Foreground="#F5F7FA" Padding="12,8"/></StackPanel>
        <StackPanel><TextBlock Text="MACRO LIBRARY" FontSize="11" Foreground="#929AAD" FontWeight="SemiBold"/><TextBox x:Name="SearchBox" Margin="0,8,0,10" Background="#171B24" Foreground="#F5F7FA" BorderBrush="#272D3A" CaretBrush="#F5F7FA" TextChanged="SearchBox_TextChanged"/><ListBox x:Name="MacroList" ItemContainerStyle="{StaticResource DarkListBoxItem}" SelectionChanged="MacroList_SelectionChanged" Background="#171B24" Foreground="#F5F7FA" BorderBrush="#272D3A">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid MinHeight="28">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="✎" Tag="{Binding}" Click="RenameMacro_Click" ToolTip="Rename macro" Width="28" Height="24" Padding="0" Background="Transparent" BorderBrush="Transparent" Foreground="#F5F7FA"/>
                <Grid.ContextMenu>
                  <ContextMenu Background="#171B24" Foreground="#F5F7FA">
                    <MenuItem Header="Rename" Click="RenameContext_Click" Foreground="#F5F7FA"/>
                    <MenuItem Header="Duplicate" Click="DuplicateContext_Click" Foreground="#F5F7FA"/>
                    <Separator/>
                    <MenuItem Header="Remove" Click="RemoveContext_Click" Foreground="#FF8A9A"/>
                  </ContextMenu>
                </Grid.ContextMenu>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox></StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Column="2" Background="#11141B" BorderBrush="#272D3A" BorderThickness="1" CornerRadius="14" Padding="18">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Recorder dashboard" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Record once, replay to selected managed clients without changing foreground focus." Foreground="#929AAD" Margin="0,3,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,12"><Button x:Name="RecordButton" Content="●  Record" Click="Record_Click" Background="#7C5CFC" Foreground="White" Padding="16,8"/><CheckBox x:Name="PanelModeCheck" Content="Panel mode" Foreground="#F5F7FA" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Record keystrokes while the panel is focused (no window minimization)."/><Button Content="Play selected" Click="Play_Click" Margin="8,0,0,0" Background="#1D2230" Foreground="#F5F7FA" Padding="16,8"/><Button Content="STACK" Click="Stack_Click" Margin="8,0,0,0" Background="#1D2230" Foreground="#F5F7FA" Padding="12,8"/><Button Content="GRID" Click="Grid_Click" Margin="8,0,0,0" Background="#1D2230" Foreground="#F5F7FA" Padding="12,8"/><Button Content="RESET" Click="Reset_Click" Margin="8,0,0,0" Background="#1D2230" Foreground="#F5F7FA" Padding="12,8"/></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#171B24" CornerRadius="10" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="EVENT SEQUENCE" Foreground="#929AAD" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="EventSummaryText" Foreground="#929AAD" FontSize="11" VerticalAlignment="Center"/></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Insert event" Click="InsertEvent_Click" Background="#1D2230" Foreground="#F5F7FA" Padding="10,5" FontSize="12"/><Button Content="Clear all" Click="ClearEvents_Click" Margin="8,0,0,0" Background="#1D2230" Foreground="#FF8A9A" Padding="10,5" FontSize="12"/></StackPanel><ListBox x:Name="EventList" Grid.Row="2" ItemContainerStyle="{StaticResource DarkListBoxItem}" AllowDrop="True" Margin="0,8,0,0" Background="#171B24" Foreground="#F5F7FA" BorderBrush="#272D3A" PreviewMouseLeftButtonDown="EventList_PreviewMouseLeftButtonDown" DragOver="EventList_DragOver" Drop="EventList_Drop" MouseDoubleClick="EventList_MouseDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="36"/><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                    <TextBlock Text="⠿" Tag="dragHandle" Foreground="#929AAD" Cursor="SizeAll" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Drag to reorder"/>
                    <TextBlock Grid.Column="1" Text="{Binding IndexText}" Foreground="#929AAD" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Badge}" Foreground="{Binding BadgeBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="4" Text="{Binding DelayText, Mode=OneWay}" Width="58" HorizontalAlignment="Right" VerticalContentAlignment="Center" Background="#171B24" Foreground="#F5F7FA" BorderBrush="#272D3A" CaretBrush="#F5F7FA" Tag="{Binding Index}" ToolTip="Delay until the next event (ms)" LostFocus="DelayBox_LostFocus" KeyDown="DelayBox_KeyDown"/>
                    <Button Grid.Column="5" Content="✕" Click="DeleteEvent_Click" Tag="{Binding Index}" ToolTip="Delete event" Width="24" Height="24" Padding="0" Background="Transparent" BorderBrush="Transparent" Foreground="#FF8A9A"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox></Grid></Border><Border Grid.Column="2" Background="#171B24" CornerRadius="10" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ASSIGNMENTS &amp; ACTIVITY" Foreground="#929AAD" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Copy log" Click="CopyLog_Click" Background="#1D2230" Foreground="#F5F7FA" Padding="8,4" FontSize="11" ToolTip="Copy the full diagnostics log to the clipboard"/></Grid><TextBlock x:Name="StatusText" Grid.Row="1" Text="Select a macro to begin." Margin="0,12,0,12" TextWrapping="Wrap"/><StackPanel Grid.Row="2"><TextBlock Text="LIVE DIAGNOSTICS" Foreground="#929AAD" FontSize="11"/><ListBox x:Name="DiagnosticsList" SelectionMode="Extended" ItemContainerStyle="{StaticResource DarkListBoxItem}" Margin="0,8,0,0" Background="#171B24" Foreground="#F5F7FA" BorderBrush="#272D3A" PreviewKeyDown="DiagnosticsList_PreviewKeyDown">
                <ListBox.ContextMenu>
                  <ContextMenu Background="#171B24" Foreground="#F5F7FA">
                    <MenuItem Header="Copy selected" Click="CopySelectedLog_Click" Foreground="#F5F7FA"/>
                    <MenuItem Header="Copy all" Click="CopyAllLog_Click" Foreground="#F5F7FA"/>
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox></StackPanel></Grid></Border></Grid>
        <TextBlock Grid.Row="3" x:Name="FooterText" Text="Background-safe mode: no focus APIs are used." Foreground="#929AAD" Margin="0,14,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
