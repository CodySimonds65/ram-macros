<Application x:Class="RamMacros.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI Variable Text"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#171B24"/><Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="BorderBrush" Value="#272D3A"/><Setter Property="CaretBrush" Value="#F5F7FA"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#171B24"/><Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="BorderBrush" Value="#272D3A"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,0,4"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#7C5CFC"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
  </Application.Resources>
</Application>
